# EcoSort - Environment Configuration Template
DATABASE_URL="postgresql://postgres:password@localhost:5432/ecosort?schema=public"

# Authentication Security
JWT_SECRET="your-super-secret-jwt-signing-key-min-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Hugging Face Vision AI Inference Configuration
HF_TOKEN="your_hugging_face_user_access_token_here"
HF_MODEL_ID="yangy50/garbage-classification"
AI_PROVIDER="huggingface"
AI_CONFIDENCE_THRESHOLD="0.80"

# Optional Cloudinary Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
