# EcoSort - Environment Configuration Template

# Supabase PostgreSQL Database (Transaction Pooler - Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL Direct / Session Connection (Port 5432 for Prisma Migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Storage Configuration (waste-images bucket)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_public_key"

# Authentication Security
JWT_SECRET="your-super-secret-jwt-signing-key-min-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Google Gemini Vision AI Configuration
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL_ID="gemini-1.5-flash"
AI_PROVIDER="gemini"
AI_CONFIDENCE_THRESHOLD="0.75"

# Optional Cloudinary Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
